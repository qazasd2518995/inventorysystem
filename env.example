# 資料庫連接設定
DATABASE_URL=postgresql://username:password@host:port/database
DB_HOST=your-postgres-host
DB_NAME=your-database-name
DB_USER=your-username
DB_PASSWORD=your-password
DB_PORT=5432
DB_SSL=false

# 應用程式設定
PORT=3000
NODE_ENV=development

# 登入系統設定
LOGIN_USERNAME=your-username
# 請用 bcrypt 雜湊；可執行：node -e "require('bcryptjs').hash('your-password', 12).then(console.log)"
LOGIN_PASSWORD_HASH=$2b$12$replace-with-your-bcrypt-hash
SESSION_SECRET=your-session-secret-key

# 爬蟲設定
MAX_PAGES=50
SCRAPE_DELAY=1000
PAGE_LOAD_WAIT=5000
COUNT_CHECK_TIMEOUT_MS=15000

# 露天批次 API（賣家 ID 可從賣場頁取得）
RUTEN_SELLER_ID=1994160
RUTEN_API_TIMEOUT_MS=20000
RUTEN_REQUEST_DELAY_MS=100

# 獨立排程同步（UTC 0=星期日）
WEEKLY_FULL_SYNC=true
WEEKLY_FULL_SYNC_DAY_UTC=0

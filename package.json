{
  "name": "yahoo-auction-exporter",
  "version": "1.0.0",
  "description": "源正山 Yahoo 與友茂工具露天商品同步及匯出系統",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node --check server.js",
    "sync:smart": "node jobs/sync.js",
    "sync:full": "node jobs/sync.js --force",
    "sync:scheduled": "node jobs/sync.js --scheduled",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "puppeteer": "^24.43.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}

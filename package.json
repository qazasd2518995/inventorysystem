{
  "name": "yahoo-auction-exporter",
  "version": "1.0.0",
  "description": "源正山 Yahoo 與友茂工具露天商品同步及匯出系統",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node --check server.js",
    "sync:smart": "node jobs/sync.js",
    "sync:full": "node jobs/sync.js --force",
    "sync:scheduled": "node jobs/sync.js --scheduled",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "pg": "^8.16.3",
    "puppeteer": "^24.16.2",
    "puppeteer-core": "^24.16.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
